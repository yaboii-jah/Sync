{
  "name": "Sync \u2014 Student Edition",
  "short_name": "Sync",
  "description": "Your companion app for AWS Student Community Day Mega Manila 2026.",
  "start_url": "/home",
  "display": "standalone",
  "background_color": "#024056",
  "theme_color": "#024056",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
