NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional locally, set it in production. Vercel Cron sends this as
# `Authorization: Bearer <value>` to /api/cron/keep-alive; while it is unset
# that endpoint answers anyone.
CRON_SECRET=any-long-random-string
